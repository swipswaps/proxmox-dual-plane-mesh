[Unit]
Description=Tor Rendezvous Relay Forwarder (Socat)
After=tor.service network.target
Wants=tor.service

[Service]
Type=simple
ExecStart=/usr/bin/socat TCP4-LISTEN:4242,fork,bind=127.0.0.1 SOCKS4a:127.0.0.1:127.0.0.1:4242,socksport=9050
Restart=always
RestartSec=5s

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
