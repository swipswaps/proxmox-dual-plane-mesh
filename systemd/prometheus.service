[Unit]
Description=Prometheus Monitoring Engine
After=network.target

[Service]
Type=simple
User=prometheus
Group=prometheus
ExecStart=/usr/bin/prometheus --config.file=/etc/prometheus/prometheus.yml --web.listen-address=127.0.0.1:9090
Restart=always
RestartSec=5s

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/prometheus
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
